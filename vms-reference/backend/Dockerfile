# ---- Backend: Express + Prisma ----
FROM node:20-alpine AS base
WORKDIR /app
 
# Prisma on Alpine needs OpenSSL present so it loads the correct (musl/openssl-3)
# query engine at runtime; wget is used by the container healthcheck.
RUN apk add --no-cache openssl libc6-compat
 
# Install deps (with dev deps for prisma generate)
COPY package*.json ./
COPY prisma ./prisma
RUN npm ci
 
# App source
COPY . .
 
# Prisma client is generated by the postinstall hook above; ensure it's current
RUN npx prisma generate
 
ENV NODE_ENV=production
ENV PORT=8000
EXPOSE 8000
 
# Uploaded photos live on a mounted volume
VOLUME ["/app/uploads"]
 
# Run migrations then start (idempotent on every boot)
CMD ["sh", "-c", "npx prisma migrate deploy && node prisma/seed.js && node src/server.js"]
