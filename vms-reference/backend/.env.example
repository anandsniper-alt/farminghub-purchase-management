# ----- Server -----
NODE_ENV=development
PORT=8000
 
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173
 
# ----- Database (PostgreSQL) -----
# Local example: postgresql://USER:PASSWORD@localhost:5432/fh_vms?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fh_vms?schema=public
 
# ----- Auth -----
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
 
# ----- Uploads -----
# Directory (mounted volume in production) where vendor photos are stored
UPLOAD_DIR=uploads
# Public base path the API serves uploads from
UPLOAD_URL_PATH=/uploads
# Max upload size in MB
MAX_UPLOAD_MB=8
 
# ----- Seed admin (used by prisma/seed.js on first run) -----
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@farminghub.in
SEED_ADMIN_PASSWORD=REPLACE_BEFORE_USE
