// Farming Hub — Vendor Management (Purchase CRM)
// PostgreSQL + Prisma schema
 
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; musl target for the Alpine container at runtime
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
 
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------
 
enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
  PURCHASE // legacy
  VIEWER // legacy
}
 
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  permissions  Json? // per-user permission overrides (partial); null = use role defaults
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
 
  vendors           Vendor[]               @relation("CreatedVendors")
  assignedVendors   Vendor[]               @relation("AssignedVendors")
  interactions      Interaction[]
  columnPreferences ColumnPreference[]
  passwordResets    PasswordResetRequest[] @relation("UserResets")
  resolvedResets    PasswordResetRequest[] @relation("ResolvedResets")
 
  @@map("users")
}
 
/// Configurable list-column layout. One row per (listKey, scope, user).
/// scope GLOBAL (userId null) = admin default for everyone; USER = personal override.
model ColumnPreference {
  id        String   @id @default(cuid())
  listKey   String // 'vendors' | 'follow-ups'
  scope     String // 'GLOBAL' | 'USER'
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  config    Json // ordered [{ key, label?, visible, width?, frozen? }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@unique([listKey, scope, userId])
  @@index([userId])
  @@map("column_preferences")
}
 
/// Per-role default permission matrix (JSON: { moduleKey: {view,create,edit,delete} }).
model RolePermission {
  id          String   @id @default(cuid())
  role        Role     @unique
  permissions Json
  updatedAt   DateTime @updatedAt
 
  @@map("role_permissions")
}
 
enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
}
 
/// Password-reset request awaiting admin approval.
model PasswordResetRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation("UserResets", fields: [userId], references: [id], onDelete: Cascade)
  newPasswordHash String
  note            String?
  status          ResetStatus @default(PENDING)
  requestedAt     DateTime    @default(now())
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?       @relation("ResolvedResets", fields: [resolvedById], references: [id], onDelete: SetNull)
 
  @@index([status])
  @@map("password_reset_requests")
}
 
// ---------------------------------------------------------------------------
// Taxonomies
// ---------------------------------------------------------------------------
 
/// Top-level grouping for product lines: Utilities, LAE, Implements (user-editable).
model CategoryGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  categories ProductCategory[]
 
  @@map("category_groups")
}
 
/// Company product-line items (Power Weeder, Tarpaulin, Shadenet…) nested under a group.
model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
 
  groupId String?
  group   CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
 
  vendors Vendor[] @relation("VendorCategories")
 
  @@index([groupId])
  @@map("product_categories")
}
 
/// Product / component tags a vendor supplies: Engine, Water Pump, Power Sprayer…
model ComponentTag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  vendors Vendor[] @relation("VendorComponents")
  samples Sample[]
 
  @@map("component_tags")
}
 
// ---------------------------------------------------------------------------
// Editable lookup lists
// ---------------------------------------------------------------------------
 
/// Pipeline stage for a vendor (New Lead, Approved Vendor, Blacklisted…), user-editable.
model VendorStage {
  id              String   @id @default(cuid())
  name            String   @unique
  order           Int      @default(0)
  color           String? // tailwind tone: gray|green|blue|amber|red|purple
  countsInSourcing Boolean @default(true) // false = excluded from concentration (e.g. Blacklisted)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
 
  vendors Vendor[]
 
  @@map("vendor_stages")
}
 
/// Photo type option (Product, Booth, Online…), user-editable.
model PhotoType {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  photos Photo[]
 
  @@map("photo_types")
}
 
/// Product-line classification for a vendor (UTILITY, LAE, IMPLEMENTS…), user-editable.
model ProductLine {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  vendors Vendor[]
 
  @@map("product_lines")
}
 
/// Country master (India, China…). Top of the cascading location hierarchy.
model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String? // ISO code (optional): IN, CN…
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  states  State[]
  vendors Vendor[]
 
  @@map("countries")
}
 
/// State / province master, scoped to a country.
model State {
  id        String   @id @default(cuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  districts District[]
  vendors   Vendor[]
 
  @@unique([countryId, name])
  @@index([countryId])
  @@map("states")
}
 
/// District master, scoped to a state.
model District {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  vendors Vendor[]
 
  @@unique([stateId, name])
  @@index([stateId])
  @@map("districts")
}
 
/// Currency + its value in INR (manually maintained), used for sample price conversion.
model CurrencyRate {
  code       String   @id // "INR", "USD", "YUAN"
  name       String
  symbol     String?
  inrPerUnit Decimal  @db.Decimal(14, 6) // value of 1 unit of this currency in INR
  updatedAt  DateTime @updatedAt
 
  @@map("currency_rates")
}
 
// ---------------------------------------------------------------------------
// Expos / sourcing trips
// ---------------------------------------------------------------------------
 
model Expo {
  id        String    @id @default(cuid())
  name      String
  edition   String?
  year      Int?
  city      String?
  country   String?
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
 
  vendors Vendor[]
 
  @@unique([name, edition, year])
  @@map("expos")
}
 
// ---------------------------------------------------------------------------
// Vendor (supplier contact record)
// ---------------------------------------------------------------------------
 
model Vendor {
  id          String  @id @default(cuid())
  name        String // primary contact person
  designation String? // primary contact designation (MD, Manager…)
  companyName String?
  phone       String?
  wechat      String?
  email       String?
  website     String?
 
  // Legacy free-text location (kept as fallback / for search + old records)
  city    String?
  region  String?
  country String? @default("China")
 
  // Structured location (masters — cascading Country → State → District)
  countryId  String?
  countryRef Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  stateId    String?
  stateRef   State?    @relation(fields: [stateId], references: [id], onDelete: SetNull)
  districtId String?
  districtRef District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
 
  // Product-line classification (master)
  productLineId String?
  productLine   ProductLine? @relation(fields: [productLineId], references: [id], onDelete: SetNull)
 
  expoId String?
  expo   Expo?   @relation(fields: [expoId], references: [id], onDelete: SetNull)
 
  // Pipeline stage (configurable)
  stageId String?
  stage   VendorStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
 
  // Legacy manual ratings (kept for back-compat; superseded by the weighted evaluation below)
  communicationRating Int?
  reliabilityRating   Int?
 
  // ---- Weighted vendor evaluation (each criterion rated 1-5) ----
  evalProductQuality    Int? // Product Quality Strength   20%
  evalQualityControl    Int? // Quality Control Systems     15%
  evalReliability       Int? // Reliability                 12%
  evalFinancialStrength Int? // Financial Strength          10%
  evalProductionVolume  Int? // Annual Production Volume     8%
  evalCredibility       Int? // Credibility                  8%
  evalPricingSupport    Int? // Pricing Support              8%
  evalCommunication     Int? // Communication                6%
  evalWillingness       Int? // Willingness to Cooperate     5%
  evalCreditSupport     Int? // Credit Support               4%
  evalMarketExposure    Int? // Market Exposure              4%
 
  // ---- Auto-computed evaluation results (derived from the criteria above) ----
  overallRating     Float? // weighted score on a 5-point scale (e.g. 4.32)
  overallPercentage Float? // 0-100
  supplierGrade     String? // A+ | A | B | C | D
  supplierStatus    String? // Preferred Supplier | Approved | ...
 
  annualVolume String?
  remarks      String?
  sampleStatus SampleStatus?
  status       VendorStatus  @default(ACTIVE)
 
  // Ownership for follow-ups
  assignedToId String?
  assignedTo   User?   @relation("AssignedVendors", fields: [assignedToId], references: [id], onDelete: SetNull)
 
  createdById String?
  createdBy   User?   @relation("CreatedVendors", fields: [createdById], references: [id], onDelete: SetNull)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  components   ComponentTag[]    @relation("VendorComponents")
  categories   ProductCategory[] @relation("VendorCategories")
  samples      Sample[]
  photos       Photo[]
  contacts     VendorContact[]
  interactions Interaction[]
 
  @@index([city])
  @@index([expoId])
  @@index([stageId])
  @@index([status])
  @@index([countryId])
  @@index([stateId])
  @@index([districtId])
  @@index([productLineId])
  @@index([assignedToId])
  @@index([overallRating])
  @@map("vendors")
}
 
enum VendorStatus {
  ACTIVE
  ARCHIVED
  BLACKLISTED
}
 
/// Additional contact people for a vendor.
model VendorContact {
  id          String  @id @default(cuid())
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  designation String?
  isPrimary   Boolean @default(false)
  order       Int     @default(0)
 
  @@index([vendorId])
  @@map("vendor_contacts")
}
 
// ---------------------------------------------------------------------------
// Sample tracking — per vendor / component
// ---------------------------------------------------------------------------
 
enum SampleStatus {
  NONE
  REQUESTED
  RECEIVED
  APPROVED
  REJECTED
}
 
model Sample {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
 
  componentTagId String?
  componentTag   ComponentTag? @relation(fields: [componentTagId], references: [id], onDelete: SetNull)
  componentName  String?
 
  status         SampleStatus @default(REQUESTED)
  price          Decimal?     @db.Decimal(12, 2)
  currency       String?      @default("INR") // currency code, matches CurrencyRate.code
  priceRemarks   String?
  qualityRemarks String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  @@index([vendorId])
  @@map("samples")
}
 
// ---------------------------------------------------------------------------
// Photos — product / booth / online, capturable at the expo
// ---------------------------------------------------------------------------
 
model Photo {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
 
  filename String
  url      String
  caption  String?
 
  typeId    String?
  photoType PhotoType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeLabel String     @default("Product") // snapshot label for display
 
  sizeBytes Int?
  mimeType  String?
 
  createdAt DateTime @default(now())
 
  @@index([vendorId])
  @@map("photos")
}
 
// ---------------------------------------------------------------------------
// Interaction log — conversations per vendor (typed / voice / document)
// ---------------------------------------------------------------------------
 
enum InteractionType {
  NOTE
  CALL
  MEETING
  VISIT
  ONLINE
  VOICE
  DOCUMENT
}
 
model Interaction {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
 
  type       InteractionType @default(NOTE)
  title      String?
  notes      String? // typed discussion points
  occurredAt DateTime        @default(now())
 
  // Follow-up scheduling
  nextFollowUpAt      DateTime? // next planned follow-up (required for new interactions)
  followUpCompleted   Boolean   @default(false)
  followUpCompletedAt DateTime?
 
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
 
  attachments InteractionAttachment[]
 
  createdAt DateTime @default(now())
 
  @@index([vendorId])
  @@index([nextFollowUpAt])
  @@map("interactions")
}
 
enum AttachmentKind {
  AUDIO
  DOCUMENT
  IMAGE
  OTHER
}
 
model InteractionAttachment {
  id            String      @id @default(cuid())
  interactionId String
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
 
  filename  String
  url       String
  kind      AttachmentKind @default(DOCUMENT)
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime       @default(now())
 
  @@index([interactionId])
  @@map("interaction_attachments")
}
